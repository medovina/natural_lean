import Natural

-- tutorial world

Theorem.  For all x, q : Nat, 37x + q = 37x + q.

Theorem.  For all x, y : Nat, if y = x + 7 then 2y = 2(x + 7).

Theorem.  2 = Nat.succ(Nat.succ(0)).

Theorem.  For all a, b, c : Nat, a + (b + 0) + (c + 0) = a + b + c.

Theorem.  For all a : Nat, Nat.succ(a) = a + 1 .

Theorem.  2 + 2 = 4 .

-- addition world

Theorem.  For all n : Nat, 0 + n = n.
